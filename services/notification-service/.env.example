# Local (non-Docker) settings for this service. Copy to .env in this directory.
# PLACEHOLDERS ONLY — never commit real secrets. An empty INTERNAL_API_TOKEN uses a
# dev-only default when APP_ENV=development; production refuses to start without it.
APP_ENV=development
LOG_LEVEL=INFO
# RS256 public verification keys (one <kid>.pem per key) from `make dev-keys`
JWT_PUBLIC_KEYS_DIR=../../secrets/jwt/public
JWT_ISSUER=meshbank-auth
JWT_AUDIENCE=meshbank-api
INTERNAL_API_TOKEN=
HTTP_TIMEOUT_SECONDS=3
DATABASE_URL=sqlite:///./data/notifications.db
NOTIFICATION_DELIVERY_LOG=./data/notification-deliveries.log
NOTIFICATION_SIMULATED_FAILURE_TYPES=
