# Local (non-Docker) settings for this service. Copy to .env in this directory.
# PLACEHOLDERS ONLY — never commit real secrets. An empty INTERNAL_API_TOKEN uses a
# dev-only default when APP_ENV=development; production refuses to start without it.
APP_ENV=development
LOG_LEVEL=INFO
# RS256 public verification keys (one <kid>.pem per key) from `make dev-keys`
JWT_PUBLIC_KEYS_DIR=../../secrets/jwt/public
# Signing key (auth only). Its public half must be in JWT_PUBLIC_KEYS_DIR.
JWT_PRIVATE_KEY_FILE=../../secrets/jwt/private/dev-local-1.pem
JWT_SIGNING_KEY_ID=dev-local-1
JWT_ISSUER=meshbank-auth
JWT_AUDIENCE=meshbank-api
INTERNAL_API_TOKEN=
HTTP_TIMEOUT_SECONDS=3
DATABASE_URL=sqlite:///./data/auth.db
ACCESS_TOKEN_TTL_SECONDS=900
# Argon2id cost (defaults: 3 / 65536 KiB / 4)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
# Login throttling (fixed windows that expire; no permanent lockout)
LOGIN_THROTTLE_ENABLED=true
LOGIN_IP_MAX_FAILURES=20
LOGIN_IP_WINDOW_SECONDS=300
LOGIN_ACCOUNT_IP_MAX_FAILURES=5
LOGIN_ACCOUNT_MAX_FAILURES=50
LOGIN_ACCOUNT_WINDOW_SECONDS=900
# Comma-separated CIDRs of reverse proxies trusted for X-Forwarded-For (empty = none)
TRUSTED_PROXY_CIDRS=
