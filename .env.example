# MeshBank root environment for docker compose. Copy to .env (never commit .env).
# PLACEHOLDERS ONLY. Leaving INTERNAL_API_TOKEN empty in development uses a
# built-in, clearly-labelled dev-only token. APP_ENV=production refuses to start
# unless INTERNAL_API_TOKEN is a strong random value, e.g. generated with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# JWTs are RS256: run `make dev-keys` once; Compose mounts ./secrets/jwt/public
# into every service and the private key into the auth service only.
# Production rejects development key IDs (dev-*).
APP_ENV=development
LOG_LEVEL=INFO
JWT_SIGNING_KEY_ID=dev-local-1
JWT_ISSUER=meshbank-auth
JWT_AUDIENCE=meshbank-api
ACCESS_TOKEN_TTL_SECONDS=900
# Reverse proxies whose X-Forwarded-For is trusted for login throttling (none locally)
TRUSTED_PROXY_CIDRS=
INTERNAL_API_TOKEN=
HTTP_TIMEOUT_SECONDS=3
# create_all keeps existing Phase 1 SQLite volumes working; upgrade for fresh volumes
DB_MIGRATION_MODE=create_all

# Development-only balance seeding (must be false in production)
DEV_SEED_ENABLED=true

# Fraud rules (amounts strictly above the threshold trigger the rule)
FRAUD_REVIEW_THRESHOLD=50000.00
FRAUD_HARD_LIMIT=200000.00
FRAUD_HARD_LIMIT_ACTION=REJECT
FRAUD_BLOCKED_PAYEES=

# Simulated payment provider
PAYMENT_PROVIDER_DECLINE_PREFIX=DECLINE
PAYMENT_PROVIDER_MAX_AMOUNT=100000.00

# Workflow recovery loop interval (0 disables)
RECOVERY_INTERVAL_SECONDS=30

# Simulated notification delivery failures (comma-separated types or *)
NOTIFICATION_SIMULATED_FAILURE_TYPES=
